{
  "name": "llm-guard-extension",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "LLM Guard v3 — Chrome extension (Manifest V3) that anonymizes or blocks PII in prompts sent to LLM services.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\""
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  }
}
