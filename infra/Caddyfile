{
  # Local dev: serve over plain HTTP on :80 (no TLS, no public domain).
  # For production, replace :80 with your domain (e.g. dashboard.example.com)
  # and uncomment the email line so Caddy can obtain Let's Encrypt certs.
  # email ops@example.com
  auto_https off
}

:80 {
  encode zstd gzip

  # API + WebSockets live stream
  reverse_proxy /api/* api:8000 {
    transport http {
      versions 1.1 2
    }
  }
  @live path /api/v1/live
  reverse_proxy @live api:8000

  # Keycloak
  reverse_proxy /auth/* keycloak:8080

  # Dashboard SSR (everything else)
  reverse_proxy /* dashboard:4000
}
