[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = v3_req

[dn]
C  = FR
O  = LLM Guard
CN = llm-guard.local

[v3_req]
basicConstraints = CA:FALSE
keyUsage         = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName   = @alt_names

[alt_names]
DNS.1 = llm-guard.local
DNS.2 = api.llm-guard.local
DNS.3 = auth.llm-guard.local
DNS.4 = presidio.llm-guard.local
DNS.5 = localhost
IP.1  = 127.0.0.1
IP.2  = ::1
