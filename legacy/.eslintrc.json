{
  "root": true,
  "env": {
    "browser": true,
    "node": true,
    "es2022": true,
    "webextensions": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-undef": "error",
    "no-console": "off",
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "prefer-const": "warn",
    "eqeqeq": ["warn", "smart"],
    "no-var": "warn",
    "no-constant-condition": ["error", { "checkLoops": false }]
  },
  "ignorePatterns": [
    "vendor/**",
    "dashboard/**",
    "api-java/**",
    "config/company-rules.js",
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": ["tests/**/*.js", "build.js"],
      "env": { "node": true, "browser": false }
    }
  ]
}
