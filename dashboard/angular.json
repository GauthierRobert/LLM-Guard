{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "dashboard": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "lg",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/dashboard",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.scss"],
            "ssr": { "entry": "src/server.ts" }
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "sourceMap": false },
            "development": { "optimization": false, "sourceMap": true, "namedChunks": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "dashboard:build:production" },
            "development": { "buildTarget": "dashboard:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
